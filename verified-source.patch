+    "真实三模型复核与裁决": "model-team/report.json",
+    "本地扩散模型实推": "diffusion-model/report.json",
+    "数据控件与旧工作流": "typed-controls/report.json",
+    "模块表单": "module-forms/report.json",
+    "分镜交接与创意选优": "selection/report.json",
+    "单屏剪辑": "studio/report.json",
