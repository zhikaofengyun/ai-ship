+"""Run real Chromium against a real isolated local API, never a browser session.
+
+Every invocation starts and destroys a synthetic workspace. Screenshots and JSON
+are evidence of the checked paths, not proof of unavailable external services.
+"""
+
+from __future__ import annotations
+
+import argparse
+from contextlib import contextmanager
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+
+import httpx
+from playwright.sync_api import sync_playwright, expect
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+VIEWPORTS = {
+    "1": (1440, 960, 390, 844),
+    "2": (1536, 960, 414, 896),
+    "3": (1280, 900, 375, 812),
+    "4": (1600, 1000, 430, 932),
+    "5": (1366, 900, 360, 800),
+}
+
+
+@contextmanager
+def server(workspace: Path, output: Path, *, fixture_env: dict | None = None):
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        port = sock.getsockname()[1]
+    env = {
+        **os.environ,
+        "AI_SHIP_MODE": "local",
+        "AI_SHIP_DATA_DIR": str(workspace),
+        "AI_SHIP_DB": str(workspace / "browser.sqlite3"),
+        "AI_SHIP_PROVIDERS": "{}",
+        "NO_PROXY": "localhost,127.0.0.1",
+        "no_proxy": "localhost,127.0.0.1",
+        **(fixture_env or {}),
+    }
+    with (output / "server.log").open("w") as log:
+        process = subprocess.Popen(
+            [
+                sys.executable,
+                "-m",
+                "uvicorn",
+                "app.main:app",
+                "--host",
+                "127.0.0.1",
+                "--port",
+                str(port),
+            ],
+            cwd=ROOT,
+            env=env,
+            stdout=log,
+            stderr=subprocess.STDOUT,
+        )
+        base = f"http://127.0.0.1:{port}"
+        try:
+            with httpx.Client(trust_env=False, timeout=5) as client:
+                deadline = time.monotonic() + 30
+                while time.monotonic() < deadline:
+                    try:
+                        if client.get(base + "/api/v1/health").status_code == 200:
+                            break
+                    except httpx.RequestError:
+                        pass
+                    if process.poll() is not None:
+                        raise RuntimeError("Server exited; inspect server.log")
+                    time.sleep(0.1)
+                else:
+                    raise RuntimeError("Local test server did not become ready")
+            yield base
+        finally:
+            process.terminate()
+            try:
+                process.wait(timeout=8)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output", default="evidence/browser-development")
+    parser.add_argument("--round", default="development")
+    parser.add_argument(
+        "--quick",
+        action="store_true",
+        help="Skip the exhaustive feature/route traversal; never counts as a full round",
+    )
+    args = parser.parse_args()
+    output = Path(args.output).resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    started = datetime.now(timezone.utc).isoformat()
+    report = {
+        "round": args.round,
+        "started_at": started,
+        "browser": "Chromium",
+        "synthetic_workspace": True,
+        "checks": [],
+        "screenshots": [],
+        "console_errors": [],
+        "page_errors": [],
+        "failed_requests": [],
+        "features": [],
+        "routes": [],
+        "modules": [],
+        "limitations": [
