+    def body(self, **changes):
+        return ChatInput(
+            project_id=self.pid,
+            model_profile_id=self.profile["id"],
+            messages=[{"role": "user", "content": "Synthetic JSON test"}],
+            max_tokens=128,
+            json_output=True,
+            max_cost=1,
+            **{"idempotency_key": "synthetic-request-1", **changes},
+        )
+
+    def factory(
+        self,
+        failure=None,
+        content='{"proposal":"synthetic","evidence_refs":[]}',
+        reported_model=None,
+        after_post=None,
+    ):
+        parent = self
+
+        class FakeClient:
+            def __init__(self, **kwargs):
+                parent.assertFalse(kwargs["follow_redirects"])
+
+            def __enter__(self):
+                return self
+
+            def __exit__(self, *args):
+                pass
+
+            def post(self, url, **kwargs):
+                parent.calls += 1
+                if failure:
+                    raise failure
+                if after_post:
+                    after_post()
+                return httpx.Response(
+                    200,
+                    json={
+                        "id": "synthetic-provider-id",
+                        "model": reported_model or kwargs["json"]["model"],
+                        "choices": [{"message": {"content": content}, "finish_reason": "stop"}],
+                        "usage": {"prompt_tokens": 20, "completion_tokens": 10},
+                    },
+                )
+
+        return FakeClient
+
