+def test_symbol_exists(path, symbol):
+    tree = ast.parse((ROOT / path).read_text())
+    parts = symbol.split(".")
+    body = tree.body
+    for part in parts:
+        node = next(
+            (
+                n
+                for n in body
+                if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))
+                and n.name == part
+            ),
+            None,
+        )
+        if node is None:
+            return False
+        body = node.body
+    return True
