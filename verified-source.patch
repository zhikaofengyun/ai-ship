diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000000000000000000000000000000000000..1ec3d3b585dc11bc431f9f744ab09d541d8130d9
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,57 @@
+name: Contract, media and browser regression
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: regression-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  regression:
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7
+        with:
+          python-version: '3.12'
+          cache: pip
+      - name: Install explicit runtime and test tools
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y ffmpeg fonts-noto-cjk tesseract-ocr tesseract-ocr-eng
+          python -m pip install -r requirements-dev.txt
+          npm ci
+          python -m playwright install --with-deps chromium webkit
+      - name: Check formatting
+        run: |
+          python -m black --check app tests scripts
+          npm run format:check
+      - name: Run complete implemented-scope regression
+        run: python scripts/run_regression.py --webkit --round 1 --output evidence/ci-${{ github.run_id }}
+      - name: Preserve exact evidence, including failures
+        if: always()
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
+        with:
+          name: regression-${{ github.run_id }}
+          path: evidence/ci-${{ github.run_id }}
+          if-no-files-found: warn
+          retention-days: 14
+  container:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          persist-credentials: false
+      - name: Build container recipe without publishing
+        run: docker build --tag ai-ship:ci .
