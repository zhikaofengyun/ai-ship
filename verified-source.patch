+        self.assertEqual(check.returncode, 0, check.stderr)
+        self.assertEqual(self.post("/" + rid + "/render", render)["artifact"]["id"], artifact["id"])
+        self.assertEqual(len(self.store.list("local", kind="Artifact")), 1)
+        self.assertEqual(
