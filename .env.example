# Local mode binds to 127.0.0.1. These are documentation examples, not active secrets.
AI_SHIP_MODE=local
AI_SHIP_DATA_DIR=.data
AI_SHIP_PROVIDERS={}
# Team mode requires HTTPS reverse proxy and server-owned identities.
# Generate a strong random token and map it to a tenant/actor/role; never commit it.
# AI_SHIP_MODE=team
# AI_SHIP_API_KEYS={}
# Optional providers are JSON configured by an administrator. See docs/operations.md.


# Locally hosted image/video workers, see docs/ai-production-runtime.md.
AI_SHIP_COMFY_PROFILES={}

# Optional server-side key for the YouTube regional popular-video chart.
AI_SHIP_YOUTUBE_DATA_KEY=

# Server-owned account bindings for TikTok Display API (user.info.basic and video.list).
# Entries use tenant_id, project_id, account_id, open_id and token_env.
# token_env names a server secret beginning with AI_SHIP_TIKTOK_TOKEN_.
AI_SHIP_TIKTOK_ACCOUNTS=[]

# Optional TikTok Login Kit for Web. Bind each exact tenant/project/account/open_id.
# Client secret and Fernet key must be injected by the deployment's secret manager.
# Local OAuth setup and proxy logging requirements are in docs/tiktok-login.md.
AI_SHIP_TIKTOK_LOGIN_ACCOUNTS=[]
AI_SHIP_TIKTOK_CLIENT_KEY=
AI_SHIP_TIKTOK_REDIRECT_URI=


# Optional local model.onnx and tokenizer.json for name/tag semantic retrieval.
AI_SHIP_TEXT_MODEL_DIR=

# Server-assigned, read-only capture directories for local camera intake.
# See docs/capture-directory.md. Default grants no directories to any project.
AI_SHIP_CAPTURE_ROOTS=[]

# Optional TikTok creator-inbox delivery. Per-account video.upload + user.info.basic.
# Bind tenant_id, project_id, account_id, open_id and token_env. See docs/batch-intake-delivery.md.
AI_SHIP_TIKTOK_UPLOAD_ACCOUNTS=[]
